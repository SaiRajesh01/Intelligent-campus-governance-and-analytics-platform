# ===========================================================================
# SCGIS Backend Environment Variables
# ===========================================================================

# Server Port
PORT=5000

# MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/smart-campus?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/smart-campus
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_campus?retryWrites=true&w=majority

# JWT Secret Key (used to sign authentication tokens)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# Application Environment (development / production)
NODE_ENV=development
